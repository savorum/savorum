{
  "name": "@savorum/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "prepare": "panda codegen",
    "generate": "pnpm run generate:i18n && pnpm run generate:api && pnpm run generate:routes && panda codegen",
    "generate:brand": "node scripts/generate-brand-assets.mjs",
    "generate:api": "openapi-typescript ../api/openapi.json -o src/api/schema.d.ts",
    "generate:routes": "tsr generate",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run check:i18n && node scripts/i18n-report.mjs --supported > /dev/null && pnpm run test:i18n && pnpm run typecheck:tests && pnpm run lint && pnpm run format:check && pnpm run test:unit && pnpm run test:features",
    "check": "pnpm run generate && pnpm run typecheck && pnpm test",
    "build": "pnpm run generate && pnpm run typecheck && vite build && node scripts/sync-embed.mjs",
    "start": "node dist/server/server.js",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:unit": "node --test --experimental-test-coverage --test-coverage-include=\"src/lib/**/*.ts\" --test-coverage-include=\"src/features/**/*.ts\" --test-coverage-exclude=\"**/*.test.ts\" --test-coverage-exclude=\"**/messages.generated.ts\" --test-coverage-lines=85 --test-coverage-branches=72 --test-coverage-functions=78 \"src/lib/**/*.test.ts\" \"src/features/**/*.node.test.ts\"",
    "test:features": "vitest run --coverage",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "lint": "oxlint --type-aware src",
    "format:check": "oxfmt --check .",
    "format": "oxfmt --write .",
    "generate:i18n": "paraglide-js compile --project ./project.inlang --output-structure locale-modules && node scripts/generate-messages.ts",
    "check:i18n": "node scripts/check-i18n.mjs",
    "test:i18n": "node scripts/test-i18n.mjs",
    "i18n:report": "node scripts/i18n-report.mjs"
  },
  "dependencies": {
    "@ark-ui/solid": "^5.40.0",
    "@noble/hashes": "2.4.0",
    "@tanstack/history": "1.162.5",
    "@tanstack/solid-router": "1.170.43",
    "@tanstack/solid-start": "1.169.5",
    "lucide-solid": "^1.70.0",
    "openapi-fetch": "^0.17.0",
    "pdfjs-dist": "^6.5.438",
    "solid-js": "^1.9.18"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@inlang/paraglide-js": "^3.2.1",
    "@pandacss/dev": "^2.5.0",
    "@pandacss/preset-base": "2.5.0",
    "@pandacss/preset-panda": "2.5.0",
    "@pandacss/types": "2.5.0",
    "@park-ui/cli": "^1.0.1",
    "@playwright/test": "^1.65.0",
    "@solidjs/testing-library": "0.8.10",
    "@tanstack/router-cli": "^1.168.0",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "eslint-plugin-solid": "0.19.0",
    "jsdom": "31.0.0",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "sharp": "0.35.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vite-plugin-solid": "^2.11.15",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@12.18.0"
}
