{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "endOfLine": "lf",
  "insertFinalNewline": true,
  "objectWrap": "preserve",
  "printWidth": 100,
  "semi": false,
  "singleQuote": false,
  "sortImports": true,
  "sortPackageJson": true,
  "tabWidth": 2,
  "trailingComma": "all",
  "useTabs": false,
  "ignorePatterns": [
    "src/api/schema.d.ts",
    "src/lib/unit-registry.generated.ts",
    "src/lib/unit-locales.generated.ts",
    "src/lib/unit-locales/*.generated.ts",
    "src/lib/messages.generated.ts",
    "src/routeTree.gen.ts",
    "src/paraglide/**"
  ]
}
